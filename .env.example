# Variables opcionales para desarrollo local

# Activa la extraccion de facturas con IA (OpenAI). Sin esto, esa funcion queda deshabilitada.
OPENAI_API_KEY=

# Modelo para extraccion de facturas. Por defecto: gpt-4.1-mini
OPENAI_MODEL=gpt-4.1-mini

# Token de Vercel Blob para el inventario compartido en la nube (/api/state).
# Sin esto, cada navegador guarda los datos en localStorage.
BLOB_READ_WRITE_TOKEN=

# Solo si tienes un archivo local de inventario accesible por el servidor.
# CURRENT_INVENTORY_PATH=C:\ruta\a\copia inventario.xlsx

# Puerto del backend Express en local (por defecto 8787)
# PORT=8787
